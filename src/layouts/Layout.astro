---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Desarrollador Full Stack especializado en Angular, Spring Boot y tecnologías modernas. Creando soluciones web innovadoras y escalables.' } =
  Astro.props;
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/index.css';
import '../styles/app.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="keywords" content="desarrollador fullstack, angular, spring boot, java, typescript, portfolio, martin giner, programador murcia, developer españa" />
    <meta name="author" content="Martín Giner Navarro" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Spanish" />

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WB683J5Q');</script>
    <!-- End Google Tag Manager -->

    <!-- Performance: Resource Hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('//MartinGiner_4-2.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Martín Giner - Portfolio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/MartinGiner_4-2.png', Astro.site)} />
    <meta name="twitter:creator" content="@MartinGiner" />


    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Martín Giner Navarro",
      "url": Astro.site,
      "image": new URL('/MartinGiner_4-2.png', Astro.site),
      "sameAs": [
        "https://github.com/MartinGiner9",
        "https://www.linkedin.com/in/martin-giner-navarro/"
      ],
      "jobTitle": "Desarrollador Fullstack",
      "worksFor": {
        "@type": "Organization",
        "name": "Tragsatec"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Murcia",
        "addressCountry": "ES"
      },
      "description": description
    })} />

    <meta name="theme-color" content="#0f172a" />

    <!-- Tema inicial: aplicar antes de render para evitar FOUC -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          // If user explicitly saved 'light', enable light mode. Otherwise default to dark (no .light class).
          if (saved === 'light') {
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.remove('light');
          }
        } catch (e) {
          // ignore
        }
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:outline-none focus:ring-2 focus:ring-primary">
      Saltar al contenido principal
    </a>

    <Navbar />

    <main id="main-content" class="pt-16">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      'Open Sans',
      'Helvetica Neue',
      sans-serif;
    scroll-behavior: smooth;
  }

  body {
    line-height: 1.6;
  }
</style>
