---
import MailIcon from './icons/Mail.astro';
import MapPinIcon from './icons/MapPin.astro';
---

<section id="contact" class="py-20 relative">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 glow-text">Trabajemos Juntos</h2>
        <div class="w-20 h-1 bg-gradient-to-r from-primary to-secondary mx-auto mb-4"></div>
        <p class="text-muted-foreground text-lg">¿Tienes un proyecto en mente? ¡Hablemos!</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div class="space-y-8 animate-slide-in-left">
          <div>
            <h3 class="text-2xl font-bold mb-6">Información de Contacto</h3>
            <div class="space-y-4">
              <a
                href="mailto:martinginernavarro7@gmail.com"
                class="glass-card p-4 rounded-xl flex items-center gap-4 hover:glow-border transition-all"
              >
                <div
                  class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center"
                >
                  <MailIcon class="w-5 h-5 text-background" />
                </div>
                <div>
                  <p class="text-sm text-muted-foreground">Email</p>
                  <p class="font-medium">martinginernavarro7@gmail.com</p>
                </div>
              </a>
              <div class="glass-card p-4 rounded-xl flex items-center gap-4">
                <div
                  class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center"
                >
                  <MapPinIcon class="w-5 h-5 text-white" />
                </div>
                <div>
                  <p class="text-sm text-muted-foreground">Ubicación</p>
                  <p class="font-medium">Murcia, España</p>
                </div>
              </div>
            </div>
          </div>

          <div class="glass-card p-8 rounded-2xl">
            <h4 class="text-xl font-bold mb-4">¿Por qué trabajar conmigo?</h4>
            <ul class="space-y-3 text-muted-foreground">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span><span>Código limpio y bien documentado</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span><span>Comunicación clara y constante</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span><span>Entrega a tiempo y con calidad</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span><span>Soporte post-lanzamiento</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Contact Form (Temporalmente deshabilitado) -->
        <div class="animate-slide-in-right">
          <div class="glass-card p-8 rounded-2xl space-y-6">
            <!-- Alerta de problemas técnicos -->
            <div class="bg-amber-500/10 border-2 border-amber-500/50 rounded-xl p-6 mb-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-lg font-bold text-amber-500 mb-2">Formulario Temporalmente Deshabilitado</h4>
                  <p class="text-muted-foreground mb-3">
                    Debido a problemas técnicos, el formulario de contacto está temporalmente fuera de servicio.
                  </p>
                  <p class="text-foreground font-medium mb-2">
                    Por favor, contacta directamente a través de:
                  </p>
                  <a 
                    href="mailto:martinginernavarro7@gmail.com" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:opacity-90 transition-opacity"
                  >
                    <MailIcon class="w-4 h-4" />
                    <span>martinginernavarro7@gmail.com</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Formulario deshabilitado (visualmente gris para mostrar que está fuera de servicio) -->
            <div class="opacity-50 pointer-events-none">
              <div>
                <label for="name" class="block text-sm font-medium mb-2">Nombre</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  disabled
                  class="w-full p-3 bg-background/50 border-border rounded-md cursor-not-allowed"
                  placeholder="Tu nombre completo"
                />
              </div>

              <div class="mt-4">
                <label for="email" class="block text-sm font-medium mb-2">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  disabled
                  class="w-full p-3 bg-background/50 border-border rounded-md cursor-not-allowed"
                  placeholder="example@email.com"
                />
              </div>

              <div class="mt-4">
                <label for="message" class="block text-sm font-medium mb-2">Mensaje</label>
                <textarea
                  id="message"
                  name="message"
                  disabled
                  rows="6"
                  class="w-full p-3 bg-background/50 border-border rounded-md resize-none min-h-[150px] cursor-not-allowed"
                  placeholder="Cuéntame sobre tu proyecto..."></textarea>
              </div>

              <button
                type="button"
                disabled
                class="w-full px-6 py-3 bg-primary text-primary-foreground rounded-md cursor-not-allowed mt-4"
                >Enviar Mensaje</button
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
